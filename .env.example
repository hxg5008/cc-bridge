# ============================================
# cc-bridge Docker Compose 示例配置
# ============================================

# --- 服务器 ---
SERVER_HOST=0.0.0.0
SERVER_PORT=5674

# --- TLS（可选，留空则使用 HTTP） ---
# TLS_CERT_FILE=/path/to/cert.pem
# TLS_KEY_FILE=/path/to/key.pem

# --- 数据库 (PostgreSQL via Docker Compose) ---
# 仅支持 PostgreSQL；SQLite 已在 v1.8.x 移除（多并发下写锁问题）。
DATABASE_DRIVER=postgres
# 容器互联使用 compose 内部主机名 `postgres`；裸机/外部连接时改成 127.0.0.1。
DATABASE_DSN=postgres://cc-bridge:cc-bridge@postgres:5432/cc-bridge?sslmode=disable

# PostgreSQL 容器初始化参数（供 docker compose 的 postgres 服务使用）
# DSN 中的用户名/密码/库名要与下面三项一致
POSTGRES_USER=cc-bridge
POSTGRES_PASSWORD=cc-bridge
POSTGRES_DB=cc-bridge

# --- Redis（可选，留空则使用内存缓存） ---
# 多副本部署 / 需要跨进程粘性会话时启用：
#   docker compose --profile redis up -d
# 然后取消下面注释：
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# --- 管理员 ---
# 必须显式设强密码; "admin"/"password"/"123456" 等弱口令会让进程拒绝启动。
# 推荐生成方式: openssl rand -base64 24 | tr -d '=' | tr '/+' '-_' | head -c 32
ADMIN_PASSWORD=CHANGE_THIS_TO_STRONG_RANDOM_STRING

# --- 日志 ---
# 级别: debug, info, warn, error
LOG_LEVEL=info

# --- 时区（postgres 容器使用，影响 PG 时间字段显示）---
TZ=Asia/Shanghai
